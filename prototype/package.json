{
  "name": "herstory-astro-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "pull": "node scripts/pull-subframe.mjs",
    "sync": "node scripts/sync-components.mjs",
    "vendor-core": "node scripts/vendor-core.mjs",
    "gen": "node scripts/gen-yaml.mjs && node scripts/gen-routes.mjs",
    "shoot": "node scripts/shoot.mjs",
    "diff": "node scripts/diff.mjs",
    "refs": "node scripts/refs.mjs",
    "verify": "npm run build && npm run shoot -- --all && npm run diff -- --all && npm run gen",
    "check:yaml": "node scripts/gen-yaml.mjs --check && node scripts/gen-routes.mjs --check",
    "check:interactions": "node scripts/check-interactions.mjs",
    "signoff": "node scripts/signoff.mjs",
    "verify:chrome": "node scripts/verify-chrome.mjs",
    "verify:pipeline": "node scripts/verify-pipeline.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.0.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "astro": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "classnames": "^2.5.1",
    "copy-to-clipboard": "^4.0.2",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.50.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  }
